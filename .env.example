# ─────────────────────────────────────────────────────────────
# DomainPulse — environment
# The app runs with ZERO third-party keys. Everything below is
# optional except DATABASE_URL. Missing keys fall back to mocks.
# ─────────────────────────────────────────────────────────────

# Required: Postgres connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/domainpulse?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="dev-secret-change-me"
AUTH_URL="http://localhost:3000"

# Optional: Google OAuth (email login works without it)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional: SMTP for email login + renewal digests (logs to console if unset)
EMAIL_SERVER=""
EMAIL_FROM="DomainPulse <no-reply@domainpulse.test>"

# Optional: Redis for cache + rate limiting (in-memory fallback if unset)
REDIS_URL=""

# Optional: Stripe (billing UI renders in demo mode without it)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Optional: Anthropic (explanation layer falls back to deterministic text)
ANTHROPIC_API_KEY=""

# Optional: secret guarding the cron endpoint
CRON_SECRET="dev-cron-secret"

# Admin accounts (comma-separated emails). These accounts have UNLIMITED
# credits — spends are never charged. Add your own email to become admin.
ADMIN_EMAILS="admin@domainpulse.test"
