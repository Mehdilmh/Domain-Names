// DomainPulse — Prisma schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Auth.js models ─────────────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  credits       Int       @default(25)
  tier          String    @default("free")
  role          String    @default("user") // "user" | "admin" (admins have unlimited credits)

  accounts       Account[]
  sessions       Session[]
  appraisals     Appraisal[]
  portfolios     Portfolio[]
  apiKeys        ApiKey[]
  creditLedger   CreditLedger[]
  subscription   Subscription?
  bulkJobs       BulkJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ── Historical sales (seed data powering comps + backtest) ─────
model Sale {
  id          String   @id @default(cuid())
  domain      String
  sld         String   // second-level label, e.g. "cloudmind"
  tld         String   // e.g. "com"
  price       Int      // USD, log-normal / power-law distributed
  soldAt      DateTime
  // Cached feature vector for fast cosine similarity in comps.ts
  featureVec  Json
  source      String   @default("seed")

  createdAt DateTime @default(now())

  @@index([tld])
  @@index([soldAt])
  @@index([sld])
}

// ── Appraisals ─────────────────────────────────────────────────
model Appraisal {
  id           String   @id @default(cuid())
  domain       String
  userId       String?
  low          Int
  mid          Int
  high         Int
  confidence   Int      // 0-100
  monthsToSell Float
  liquidity    Int      // 0-100
  features     Json
  comps        Json     // array of { domain, price, soldAt, similarity }
  explanation  String   @db.Text
  trademark    Json     // { risk, level, note }
  source       String   @default("web") // web | api | bulk

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([domain])
  @@index([userId])
}

/// Content-addressed 30-day cache, keyed by domain hash. Enables
/// in-flight de-duplication of identical requests.
model AppraisalCache {
  id        String   @id @default(cuid())
  domainKey String   @unique // sha256(normalizedDomain)
  domain    String
  payload   Json     // full AppraisalResult
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// ── Portfolio ──────────────────────────────────────────────────
model Portfolio {
  id     String @id @default(cuid())
  userId String
  name   String @default("My Portfolio")

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items PortfolioItem[]

  createdAt DateTime @default(now())
}

model PortfolioItem {
  id           String    @id @default(cuid())
  portfolioId  String
  domain       String
  renewalCost  Int       @default(12) // annual, USD
  renewsAt     DateTime?
  estValue     Int?      // last appraised mid
  lastAppraised DateTime?
  notes        String?

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([portfolioId, domain])
  @@index([renewsAt])
}

// ── Billing ────────────────────────────────────────────────────
model Subscription {
  id                   String   @id @default(cuid())
  userId               String   @unique
  stripeCustomerId     String?
  stripeSubscriptionId String?
  tier                 String   @default("free")
  status               String   @default("active")
  currentPeriodEnd     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Immutable audit trail. Credits are ONLY mutated alongside a ledger
/// row inside a transaction — never optimistically.
model CreditLedger {
  id        String   @id @default(cuid())
  userId    String
  delta     Int      // negative = spend, positive = grant/purchase
  balance   Int      // resulting balance after applying delta
  reason    String   // "appraisal" | "bulk" | "purchase" | "grant" | "api"
  ref       String?  // e.g. appraisalId, stripe session id

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ── Public API keys ────────────────────────────────────────────
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String    @default("Default")
  prefix     String    // visible prefix, e.g. "dp_live_ab12"
  hashedKey  String    @unique // sha256 of full key
  tier       String    @default("free")
  lastUsedAt DateTime?
  revokedAt  DateTime?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ── Bulk jobs ──────────────────────────────────────────────────
model BulkJob {
  id           String   @id @default(cuid())
  userId       String
  status       String   @default("queued") // queued | processing | done | failed
  total        Int
  processed    Int      @default(0)
  inputDomains Json     // string[] of domains to appraise
  resultCsv    String?  @db.Text
  error        String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
